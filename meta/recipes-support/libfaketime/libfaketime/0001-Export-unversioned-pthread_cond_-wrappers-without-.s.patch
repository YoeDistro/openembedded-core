From 737ca43d8a2cac71749072740d9dc97ff7b90605 Mon Sep 17 00:00:00 2001
From: Khem Raj <raj.khem@gmail.com>
Date: Wed, 11 Nov 2026 10:08:19 -0800
Subject: [PATCH] Export unversioned pthread_cond_* wrappers without .symver
 "@@"

On ARM, or with FORCE_PTHREAD_NONVER, the pthread_cond_* wrappers are
exported via ".symver foo_232, foo@@", i.e. with an empty version. GNU ld
and gold treat that as an unversioned symbol, but lld rejects it:

  ld.lld: error: libfaketime.o: symbol pthread_cond_init@@ has undefined version

and its maintainers consider that the intended behaviour [1].

Define the plain names as aliases of the wrappers instead. Use asm labels so
the exported names are unaffected by glibc's _TIME_BITS=64 redirects in the
time64 build. The version script listed the plain names in the GLIBC_2.2.5
and GLIBC_2.3.2 nodes, which would now version the aliases. The nodes are
only needed to define the versions used by .symver, so drop the names from
them. Also narrow the local pattern pthread_cond_destroy* to
pthread_cond_destroy_* so that it no longer matches the exported symbol.

The dynamic symbol tables built with GNU ld are unchanged, with and without
FORCE_PTHREAD_NONVER, and lld now produces the same pthread_cond_* exports.

[1] https://github.com/llvm/llvm-project/issues/56385

Upstream-Status: Submitted [https://github.com/wolfcw/libfaketime/pull/570]
Signed-off-by: Khem Raj <raj.khem@gmail.com>
---
 src/libfaketime.c   | 13 ++++++++++---
 src/libfaketime.map |  7 ++++---
 2 files changed, 14 insertions(+), 6 deletions(-)

diff --git a/src/libfaketime.c b/src/libfaketime.c
index 973595f..f0a51f5 100644
--- a/src/libfaketime.c
+++ b/src/libfaketime.c
@@ -5236,9 +5236,16 @@ int pthread_cond_timedwait(pthread_cond_t *cond, pthread_mutex_t *mutex, const s
 #else
 __asm__(".symver pthread_cond_timedwait_225, pthread_cond_timedwait@GLIBC_2.2.5");
 #if defined __ARM_ARCH || defined FORCE_PTHREAD_NONVER
-__asm__(".symver pthread_cond_timedwait_232, pthread_cond_timedwait@@");
-__asm__(".symver pthread_cond_init_232, pthread_cond_init@@");
-__asm__(".symver pthread_cond_destroy_232, pthread_cond_destroy@@");
+/* Export the wrappers under their plain, unversioned names so that they
+ * interpose any version of the libc symbols. ".symver foo_232, foo@@" with an
+ * empty version only does this with GNU ld and gold, lld rejects it. The asm
+ * labels keep the exported names stable under glibc's time64 redirects. */
+#define FT_UNVERSIONED_ALIAS(FUNCTION_NAME, EXPORTED_SYMBOL) \
+  extern __typeof__(FUNCTION_NAME) ft_alias_##EXPORTED_SYMBOL \
+    __asm__(#EXPORTED_SYMBOL) __attribute__((alias(#FUNCTION_NAME)));
+FT_UNVERSIONED_ALIAS(pthread_cond_timedwait_232, pthread_cond_timedwait)
+FT_UNVERSIONED_ALIAS(pthread_cond_init_232, pthread_cond_init)
+FT_UNVERSIONED_ALIAS(pthread_cond_destroy_232, pthread_cond_destroy)
 #else
 __asm__(".symver pthread_cond_timedwait_232, pthread_cond_timedwait@@GLIBC_2.3.2");
 __asm__(".symver pthread_cond_init_232, pthread_cond_init@@GLIBC_2.3.2");
diff --git a/src/libfaketime.map b/src/libfaketime.map
index 10b9fa1..b15b1ac 100644
--- a/src/libfaketime.map
+++ b/src/libfaketime.map
@@ -22,11 +22,12 @@ GLIBC_2.34 {
   global: __clock_gettime64; __time64; sem_clockwait;
 } GLIBC_2.30;
 
+# The pthread_cond_* symbols get their versions from .symver in libfaketime.c,
+# or stay unversioned on ARM and with FORCE_PTHREAD_NONVER, so these nodes
+# must not name them.
 GLIBC_2.2.5 {
-  global:  pthread_cond_timedwait;
-  local: pthread_cond_timedwait_*; pthread_cond_init_*; pthread_cond_destroy*;
+  local: pthread_cond_timedwait_*; pthread_cond_init_*; pthread_cond_destroy_*;
 };
 
 GLIBC_2.3.2 {
-  pthread_cond_timedwait; pthread_cond_init; pthread_cond_destroy;
 } GLIBC_2.2.5;
